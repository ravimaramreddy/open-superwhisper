{
  "appId": "fyi.rlab.opensuperwhisper",
  "productName": "OpenSuperwhisper",
  "directories": { "output": "release" },
  "files": [
    "desktop/**/*.js",
    "dist/**/*",
    "local-runtime/**/*",
    "scripts/setup-local-runtime.py",
    "package.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!local-runtime/test_*.py",
    "!node_modules/**/*"
  ],
  "asarUnpack": ["local-runtime/**/*", "scripts/setup-local-runtime.py"],
  "extraFiles": [
    { "from": "resources/bin/macos-local-paste.node", "to": "Frameworks/macos-local-paste.node" }
  ],
  "extraResources": [{ "from": "src/assets/iconTemplate@3x.png", "to": "trayTemplate.png" }],
  "npmRebuild": false,
  "publish": null,
  "mac": {
    "target": [{ "target": "dmg", "arch": ["arm64"] }],
    "icon": "src/assets/icon.icns",
    "category": "public.app-category.productivity",
    "identity": null,
    "hardenedRuntime": false,
    "extendInfo": {
      "NSMicrophoneUsageDescription": "OpenSuperwhisper records your voice when you start dictation.",
      "NSAppleEventsUsageDescription": "OpenSuperwhisper inserts your completed dictation into the app you are using."
    }
  }
}
